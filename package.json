		"react-responsive": "^10.0.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@typescript-eslint/eslint-plugin": "^8.67.0",
		"@typescript-eslint/parser": "^8.67.0",
		"@wxt-dev/module-react": "^1.2.2",
		"eslint": "^10.9.0",
		"globals": "^17.11.0",
		"typescript": "^6.0.3",
